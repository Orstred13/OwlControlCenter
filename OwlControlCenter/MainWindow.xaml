<window:HeWindow x:Class="OwlControlCenter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:OwlControlCenter"
                 xmlns:window="clr-namespace:Helium.Controls.Window;assembly=Alexander.Gorbunov.Helium"
                 xmlns:button="clr-namespace:Helium.Controls.Button;assembly=Alexander.Gorbunov.Helium"
                 xmlns:editText="clr-namespace:Helium.Controls.EditText;assembly=Alexander.Gorbunov.Helium"
                 xmlns:heComboBox="clr-namespace:Helium.Controls.ComboBox;assembly=Alexander.Gorbunov.Helium"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 mc:Ignorable="d"
                 WindowTitle="OwlControlCenter"
                 Foreground="White"
                 Background="#212121"
                 ResizeMode="NoResize"
                 Height="800"
                 Width="610"
                 Closing="MainWindow_OnClosing">
    <window:HeWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Brushes.xaml" />
                <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Colors.xaml" />
                <ResourceDictionary Source="/Alexander.Gorbunov.Helium;component/Resources/Dimensions.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- В ресурсах окна/приложения -->
            <DropShadowEffect x:Key="ShadowEffect"
                              BlurRadius="10"
                              Opacity="0.2"
                              Color="Black"
                              ShadowDepth="3" />

            <SolidColorBrush x:Key="BlackBrush50" Color="#F0F0F0" />
            <SolidColorBrush x:Key="BlackBrush100" Color="#E0E0E0" />
            <SolidColorBrush x:Key="BlackBrush200" Color="#CCCCCC" />
            <SolidColorBrush x:Key="BlackBrush500" Color="#757575" />
            <SolidColorBrush x:Key="BlackBrush700" Color="#333333" />

            <!-- Общие стили -->
            <Style TargetType="TextBlock" x:Key="LabelStyle">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource BlackBrush50}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="TextBlock" x:Key="ValueStyle" BasedOn="{StaticResource LabelStyle}">
                <Setter Property="Margin" Value="16, 0"/>
                <Setter Property="Foreground" Value="{StaticResource BlackBrush200}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            
            <ObjectDataProvider MethodName="GetValues"
                                ObjectType="{x:Type sys:Enum}"
                                x:Key="StatusValues">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="local:FunctionType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </window:HeWindow.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Основной контент -->
        <Border
            VerticalAlignment="Stretch"
            Width="Auto"
            Margin="8"
            Background="{StaticResource BlackBrush700}"
            CornerRadius="4"
            Padding="12"
            HorizontalAlignment="Stretch">

            <!-- Контент -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="COM-порт:"
                    Style="{StaticResource LabelStyle}" />

                <editText:HeEditText
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Left"
                    Margin="5,0, 0, 0"/>
                
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="BaudRate:"
                    Style="{StaticResource LabelStyle}" />

                <editText:HeEditText
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"
                    HorizontalAlignment="Left"
                    Margin="5,0, 0, 0"/>
            </Grid>

        </Border>

        <Border 
            Grid.Row="1" 
            CornerRadius="4"
            Margin="8"
            Background="{StaticResource BlackBrush700}">
             
            <DataGrid
                ItemsSource="{Binding AppControllers}"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                RowHeaderWidth="0"
                EnableRowVirtualization="True"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeRows="False"
                SelectionUnit="CellOrRowHeader"
                RowBackground="{StaticResource BlackBrush700}"
                Background="Transparent"
                Foreground="{StaticResource BlackBrush50}"
                BorderBrush="Transparent"
                RowHeight="45"
                ColumnHeaderHeight="48"
                GridLinesVisibility="None">

                <DataGrid.Resources>
                    <!-- Стиль заголовков -->
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="IsHitTestVisible" Value="False" />
                        <Setter Property="Background" Value="{StaticResource BlackBrush800}" />
                        <Setter Property="Foreground" Value="{StaticResource BlackBrush50}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BlackBrush500}" />
                        <Setter Property="BorderThickness" Value="0 0 0 2" />
                        <Setter Property="Padding" Value="10 10" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Стиль заголовков для средней колонки -->
                    <Style x:Key="MiddleColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="BorderThickness" Value="1 0 1 2" />
                    </Style>
                    
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource BlackBrush50}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource BlackBrush50}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <!-- Колонки -->
                <DataGrid.Columns>
                    <DataGridTemplateColumn 
                        Header="Приложение"
                        Width="2.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <editText:HeEditText
                                    DockPanel.Dock="Left"
                                    EditTextHint="Путь"
                                    Width="300">
                
                                    <Binding
                                        Path="AppPath"
                                        Mode="TwoWay"
                                        UpdateSourceTrigger="PropertyChanged"
                                        NotifyOnValidationError="True"
                                        ValidatesOnDataErrors="True"/>
                                    <editText:HeEditText.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem 
                                                Header="Открыть проводник"
                                                Command="{Binding OpenPathDialogCommand}"/>
                                        </ContextMenu>
                                    </editText:HeEditText.ContextMenu>
                                </editText:HeEditText>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn 
                        Header="Тип функции"
                        Width="*"
                        HeaderStyle="{StaticResource MiddleColumnHeaderStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Orientation="Horizontal">
                                    <heComboBox:HeComboBox
                                        ItemsSource="{Binding Source={StaticResource StatusValues}}"
                                        SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                        HorizontalAlignment="Center"
                                        Margin="0, 5"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn 
                        Header="Уровень сигнала"
                        Binding="{Binding SignalLevel}"
                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <button:HeButton
                Width="200"
                Height="36"
                Margin="8"
                Text="Сохранить конфигурацию"
                Command="{Binding ApplyCommand}" />
            <button:HeButton
                Width="200"
                Height="36"
                Margin="8"
                Text="Перезапустить прослушивание порта"
                Command="{Binding RerunCommand}" />
            <TextBlock
                Foreground="{StaticResource PrimaryBrush400}"
                TextAlignment="Center"
                Margin="8, 0, 8, 16"
                Text="Помощь"/>
        </StackPanel>
    </Grid>
</window:HeWindow>
